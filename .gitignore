# Generated output (raw pipeline output)
# output/ handled below (Champion Grip exception)

# Downloaded 21st.dev component library (large cache, re-crawlable)
skills/animation-components/21st-dev-library/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Environment
.env
.env.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
.next/

# Archives
*.tar.gz
logs/

# Regenerable build artifacts inside generated output projects
output/**/node_modules/
output/**/.next/

# Champion Grip local storefront (tracked)
!output/
output/*
!output/championgrip-co-za/
!output/championgrip-co-za/**
